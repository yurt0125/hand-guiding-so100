{
  "dataset": {
    "repo_id": "rita/test",
    "root": "/home/rita/HandGuiding_test/project/data/raw",
    "episodes": null,
    "use_imagenet_stats": true,
    "streaming": false
  },
  "env": {
    "type": "gym_manipulator",
    "task": "so101_hilserl_task",
    "fps": 10,
    "robot": {
      "type": "so100_follower",
      "id": "left",
      "port": "/dev/ttyACM1",
      "disable_torque_on_disconnect": true,
      "use_degrees": false,
      "cameras": {
        "d435": {
          "type": "opencv",
          "index_or_path": "/dev/video10",
          "width": 640,
          "height": 480,
          "fps": 15
        },
        "fixed": {
          "type": "opencv",
          "index_or_path": "/dev/video13",
          "width": 640,
          "height": 480,
          "fps": 15
        }
      }
    },
    "teleop": {
      "type": "so101_leader",
      "id": "leader",
      "port": "/dev/ttyACM0",
      "use_degrees": false
    },
    "processor": {
      "control_mode": "gamepad",
      "observation": {
        "add_joint_velocity_to_observation": false,
        "add_current_to_observation": false,
        "display_cameras": false
      },
      "image_preprocessing": {
        "resize_size": [
          128,
          128
        ]
      },
      "gripper": {
        "use_gripper": true,
        "gripper_penalty": 0.0
      },
      "reset": {
        "fixed_reset_joint_positions": null,
        "reset_time_s": 5.0,
        "control_time_s": 20.0,
        "terminate_on_success": true
      },
      "reward_classifier": {
        "pretrained_path": null,
        "success_threshold": 0.5,
        "success_reward": 1.0
      },
      "max_gripper_pos": 100.0
    }
  },
  "policy": {
    "type": "sac",
    "device": "cuda",
    "storage_device": "cpu",
    "use_amp": false,
    "vision_encoder_name": "helper2424/resnet10",
    "freeze_vision_encoder": true,
    "shared_encoder": true,
    "image_encoder_hidden_dim": 32,
    "latent_dim": 256,
    "online_steps": 1000000,
    "online_buffer_capacity": 100000,
    "offline_buffer_capacity": 100000,
    "online_step_before_learning": 100,
    "policy_update_freq": 1,
    "discount": 0.99,
    "temperature_init": 1.0,
    "num_critics": 2,
    "critic_lr": 0.0003,
    "actor_lr": 0.0003,
    "temperature_lr": 0.0003,
    "critic_target_update_weight": 0.005,
    "utd_ratio": 1,
    "state_encoder_hidden_dim": 256,
    "target_entropy": null,
    "use_backup_entropy": true,
    "grad_clip_norm": 40.0,
    "actor_learner_config": {
      "learner_host": "127.0.0.1",
      "learner_port": 50051,
      "policy_parameters_push_frequency": 4,
      "queue_get_timeout": 2
    },
    "input_features": {
      "observation.state": {
        "type": "STATE",
        "shape": [
          6
        ]
      },
      "observation.images.d435": {
        "type": "VISUAL",
        "shape": [
          3,
          128,
          128
        ]
      },
      "observation.images.fixed": {
        "type": "VISUAL",
        "shape": [
          3,
          128,
          128
        ]
      }
    },
    "output_features": {
      "action": {
        "type": "ACTION",
        "shape": [
          4
        ]
      }
    }
  },
  "output_dir": "/home/rita/HandGuiding_test/project/outputs/hilserl/so101_rita_run1",
  "job_name": "hilserl_so101_rita",
  "resume": false,
  "seed": 1000,
  "num_workers": 4,
  "batch_size": 256,
  "steps": 100000,
  "eval_freq": 5000,
  "log_freq": 100,
  "save_checkpoint": true,
  "save_freq": 5000,
  "use_policy_training_preset": true,
  "wandb": {
    "enable": false,
    "project": "lerobot",
    "entity": null,
    "notes": null,
    "run_id": null,
    "mode": "disabled"
  }
}
